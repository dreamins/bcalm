<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="How anxious right now?"
        android:textColor="@color/widget_grey"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_n1"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="0dp"
            android:background="@drawable/widget_cell"
            android:gravity="center"
            android:text="1"
            android:textColor="@color/widget_ink"
            android:textSize="15sp" />
        <TextView
            android:id="@+id/widget_n2"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:background="@drawable/widget_cell"
            android:gravity="center"
            android:text="2"
            android:textColor="@color/widget_ink"
            android:textSize="15sp" />
        <TextView
            android:id="@+id/widget_n3"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:background="@drawable/widget_cell"
            android:gravity="center"
            android:text="3"
            android:textColor="@color/widget_ink"
            android:textSize="15sp" />
        <TextView
            android:id="@+id/widget_n4"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:background="@drawable/widget_cell"
            android:gravity="center"
            android:text="4"
            android:textColor="@color/widget_ink"
            android:textSize="15sp" />
        <TextView
            android:id="@+id/widget_n5"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:background="@drawable/widget_cell"
            android:gravity="center"
            android:text="5"
            android:textColor="@color/widget_ink"
            android:textSize="15sp" />
        <TextView
            android:id="@+id/widget_n6"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:background="@drawable/widget_cell"
            android:gravity="center"
            android:text="6"
            android:textColor="@color/widget_ink"
            android:textSize="15sp" />
        <TextView
            android:id="@+id/widget_n7"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:background="@drawable/widget_cell"
            android:gravity="center"
            android:text="7"
            android:textColor="@color/widget_ink"
            android:textSize="15sp" />
        <TextView
            android:id="@+id/widget_n8"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:background="@drawable/widget_cell"
            android:gravity="center"
            android:text="8"
            android:textColor="@color/widget_ink"
            android:textSize="15sp" />
        <TextView
            android:id="@+id/widget_n9"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:background="@drawable/widget_cell"
            android:gravity="center"
            android:text="9"
            android:textColor="@color/widget_ink"
            android:textSize="15sp" />
        <TextView
            android:id="@+id/widget_n10"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:background="@drawable/widget_cell"
            android:gravity="center"
            android:text="10"
            android:textColor="@color/widget_ink"
            android:textSize="15sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Last: -"
        android:textColor="@color/widget_grey"
        android:textSize="11sp" />
</LinearLayout>
